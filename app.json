{
  "expo": {
    "name": "platr",
    "slug": "platr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "platr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.janemanalu.platr"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f0f0f0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Platr uses your photos so you can attach one to a visit you're logging.",
          "cameraPermission": "Platr uses your camera so you can photograph a dish or place while logging a visit."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Platr uses your location to show how far your logged spots are from you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "54729b8f-0946-4c63-8287-eaa4e13d0bf5"
      }
    },
    "owner": "janemanalu"
  }
}
