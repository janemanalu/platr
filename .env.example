# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Supabase — Project Settings > API in the Supabase dashboard
#   URL:      "Project URL"
#   ANON KEY: "Project API keys" > anon / public
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Places API key — Google Cloud Console > APIs & Services > Credentials
# (needed from the Google Places integration step onward)
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Dev only — set to 1 to bypass the sign-in gate while building/reviewing screens.
# Ignored in release builds. Leave blank normally.
EXPO_PUBLIC_DEV_SKIP_AUTH=
